{
  "name": "contactmanagementsystem",
  "version": "1.0.0",
  "private": true,
  "description": "Contact Management System - Turborepo Monorepo",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:functions": "pnpm --filter api db:functions",
    "db:studio": "turbo run db:studio",
    "api:dev": "pnpm --filter api dev",
    "api:start": "pnpm --filter api start",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeghalKPSSK/ContactManagementSystem.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MeghalKPSSK/ContactManagementSystem/issues"
  },
  "homepage": "https://github.com/MeghalKPSSK/ContactManagementSystem#readme"
}
